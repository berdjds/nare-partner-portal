# Reference copy of the live /opt/stack/Caddyfile (portal.nare.am).
# The staging site (staging.portal.nare.am) is NOT part of this file: it is
# inserted into the live Caddyfile as a managed block by
# deploy/provision-server.sh.
{
	email admin@nare.am
}

portal.nare.am {
	encode gzip
	reverse_proxy portal:3000
}
